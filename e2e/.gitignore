# The fixture tree is generated by generate.py, never committed: it contains a
# nested .git/, chmod-000 entries, a FIFO, symlink loops, a non-UTF-8 filename,
# and multi-megabyte blobs — all of which git handles badly or not at all.
files/

# Scan output from running exfil against the fixtures.
store/

# Bytecode cache from running generate.py.
__pycache__/
